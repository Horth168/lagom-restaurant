# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit the real .env file – it is ignored by git.

# development | staging | production
ENVIRONMENT=development

# Where the customer/staff app runs, and where this API runs (used for QR codes and payment callbacks)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated list of websites allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Local development can use a SQLite file. Production MUST use PostgreSQL (e.g. Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./lagom.db

# A long random secret used to sign staff login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Staff stay signed in for this many minutes (720 = 12 hours)
ACCESS_TOKEN_MINUTES=720

# --- Payments: ABA KHQR + automatic confirmation (see docs/PAYMENTS_SETUP.md) ---
# The text inside your shop's ABA KHQR (starts with 000201)
KHQR_TEMPLATE=
KHQR_STORE_LABEL=LAGOM
# Telegram group where ABA's PayWay bot posts "$X paid by ..." and the listener account that reads it
PAYWAY_CHAT_ID=
PAYWAY_BOT_USERNAME=PayWayByABA_bot
# Create these with: python -m scripts.telegram_login   (the session works like a password)
TG_LISTENER_API_ID=
TG_LISTENER_API_HASH=
TG_LISTENER_SESSION=
# Minutes to pay before an unpaid order expires
PAYMENT_LIFETIME_MINUTES=15
CASH_LIFETIME_MINUTES=60
# DEVELOPMENT ONLY: adds a "Simulate ABA payment notice" button. Never in production.
KHQR_TEST_MODE=false

# --- Telegram staff alerts + pickup Mini App (optional, see docs/TELEGRAM_SETUP.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare R2 photo storage (optional; empty = save photos on the server disk) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
