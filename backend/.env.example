# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit the real .env file – it is ignored by git.

# development | staging | production
ENVIRONMENT=development

# Where the customer/staff app runs, and where this API runs (used for QR codes and payment callbacks)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated list of websites allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Local development can use a SQLite file. Production MUST use PostgreSQL (e.g. Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./lagom.db

# A long random secret used to sign staff login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Staff stay signed in for this many minutes (720 = 12 hours)
ACCESS_TOKEN_MINUTES=720

# --- ABA PayWay (see docs/ABA_PAYWAY_SETUP.md) ---
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
# Sandbox while testing; switch to https://checkout.payway.com.kh only for production
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Only needed for refunds through LAGOM (PEM text from ABA; write line breaks as 
)
ABA_PAYWAY_RSA_PUBLIC_KEY=
# Minutes the customer has to pay before an unpaid order expires
PAYMENT_LIFETIME_MINUTES=15
# DEVELOPMENT ONLY: built-in fake PayWay for testing without credentials. Never in production.
PAYWAY_SIMULATOR=false

# --- Telegram notifications (optional, see docs/TELEGRAM_SETUP.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare R2 photo storage (optional; empty = save photos on the server disk) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
