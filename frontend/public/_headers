# Security headers for the website on Cloudflare Pages (see docs/DEPLOYMENT.md)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The Telegram Mini App is shown inside Telegram (including Telegram Web), so only it may be framed, and only by Telegram
/tg*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org

# Built files have a unique name per version, so phones may keep them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The offline helper must always be fresh, so app updates reach phones
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
